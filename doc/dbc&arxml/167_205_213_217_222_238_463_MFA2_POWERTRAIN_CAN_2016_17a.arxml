    <AR-PACKAGE UUID="D420CC87EECE33EE8878EFC050587E0E">
      <SHORT-NAME>COMPUMETHODS</SHORT-NAME>
      <ELEMENTS>
	<!-- /COMPUMETHODS/c01_Dir_Same_Opposite -->
        <COMPU-METHOD UUID="25E5E7E497843E6CB57168181C806650">
          <SHORT-NAME>c01_Dir_Same_Opposite</SHORT-NAME>
          <CATEGORY>TEXTTABLE</CATEGORY>
          <COMPU-INTERNAL-TO-PHYS>
            <COMPU-SCALES>
              <COMPU-SCALE>
                <SHORT-LABEL>SAME</SHORT-LABEL>
                <DESC>
                  <L-2>Same direction as combustion engine</L-2>
                </DESC>
                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0</LOWER-LIMIT>
                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0</UPPER-LIMIT>
                <COMPU-CONST>
                  <VT>I_C01_DIR_SAME_OPPOSITE_SAME</VT>
                </COMPU-CONST>
