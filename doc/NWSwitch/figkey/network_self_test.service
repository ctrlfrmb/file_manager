[Unit]
Description=FigKey Board IP Address Broadcast Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/figkey/network_self_test.sh
WorkingDirectory=/usr/local/bin/figkey
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
