  }
  EOP_OilPressure_Encoding {
    physical_value, 0, 254, 0.04, 0, "bar" ;
    logical_value, 255, "Invalid Value" ;
  }
  EOP_OilTemperature_Encoding {
    physical_value, 0, 254, 1, -50, "degC" ;
    logical_value, 255, "Invalid Value" ;
  }
  EOP_OverloadFault_Encoding {
    logical_value, 0, "Noramal" ;
    logical_value, 1, "Failure" ;
  }
  EOP_OvertemperatureFault_Encoding {
    logical_value, 0, "Normal" ;
