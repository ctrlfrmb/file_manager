  EOP_Req0ToutFault_Encoding {
    logical_value, 0, "Normal" ;
    logical_value, 1, "Failure" ;
  }
  EOP_Res0RlngCtr_Encoding {
    physical_value, 0, 15, 1, 0 ;
  }
  EOP_Res1ChkSm_Encoding {
