  }
  EOP_OvervoltageFault_Encoding {
    logical_value, 0, "Noraml" ;
    logical_value, 1, "Failure" ;
  }
  EOP_PhaseCurrent_Encoding {
    physical_value, 0, 65534, 0.01, -327.68, "A" ;
    logical_value, 65535, "Invalid Value" ;
  }
  EOP_PreBTVerNum_Encoding {
    physical_value, 0, 14, 1, 0 ;
