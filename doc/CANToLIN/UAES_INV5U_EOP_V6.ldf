    logical_value, 0, "Noraml" ;
    logical_value, 1, "Failure" ;
  }
  EOP_HWVerNum_Encoding {
    physical_value, 0, 14, 1, 0 ;
    logical_value, 15, "Invalid Value" ;
  }
  EOP_InternalFault_Encoding {
    logical_value, 0, "Normal" ;
    logical_value, 1, "Failure" ;
  }
  EOP_LINComFault_Encoding {
    logical_value, 0, "Normal" ;
    logical_value, 1, "Failure" ;
  }
  EOP_MotorBlockFault_Encoding {
    logical_value, 0, "Noraml" ;
    logical_value, 1, "Failure" ;
  }
  EOP_NTCFault_Encoding {
    logical_value, 0, "Normal" ;
    logical_value, 1, "Failure" ;
  }
  EOP_NTCTemperature_Encoding {
    physical_value, 0, 254, 1, -50, "degC" ;
    logical_value, 255, "Invalid Value" ;
  }
  EOP_OEMID_Encoding {
    physical_value, 0, 14, 1, 0 ;
    logical_value, 0, "INV5U Platform" ;
    logical_value, 15, "Invalid Value" ;
  }
  EOP_OilOvertempDeratingFault_Encoding {
    logical_value, 0, "Normal" ;
