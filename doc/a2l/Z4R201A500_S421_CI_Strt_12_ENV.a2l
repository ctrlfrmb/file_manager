/********************* start of DAQ ************************/

  /begin DAQ                                              /* DAQ supported, at MODULE*/
    DYNAMIC                                               /* DAQ_CONFIG_TYPE */
    4                                                     /* MAX_DAQ: Total number of available DAQ lists */
    4                                                     /* MAX_EVENT_CHANNEL: Total number of available event channels */
    0                                                     /* MIN_DAQ: Total number of predefined DAQ lists */
    OPTIMISATION_TYPE_DEFAULT                             /* OPTIMISATION_TYPE */
    ADDRESS_EXTENSION_FREE                                /* ADDRESS_EXTENSION */
    IDENTIFICATION_FIELD_TYPE_ABSOLUTE                    /* IDENTIFICATION_FIELD */
    GRANULARITY_ODT_ENTRY_SIZE_DAQ_BYTE                   /* GRANULARITY_ODT_ENTRY_SIZE_DAQ */
    8                                                     /* MAX_ODT_ENTRY_SIZE_DAQ: Maximum size of ODT entry */
    OVERLOAD_INDICATION_EVENT                             /* OVERLOAD_INDICATION */
    PRESCALER_SUPPORTED

/******************* start of EVENT ************************/


	  
      /begin EVENT
        "XcpEventChannel_10ms" /* EVENT_CHANNEL_NAME */
        "10_ms" /* EVENT_CHANNEL_SHORT_NAME */
        0 /* EVENT_CHANNEL_NUMBER */
        DAQ 
        1 /* MAX_DAQ_LIST */
        10 /* TIME_CYCLE */
        6 /* TIME_UNIT */ 
        0 /* PRIORITY */
        CONSISTENCY EVENT                                     /* CONSISTENCY */
      /end EVENT
	  
	  /begin EVENT
        "XcpEventChannel_20ms" /* EVENT_CHANNEL_NAME */
        "20_ms" /* EVENT_CHANNEL_SHORT_NAME */
